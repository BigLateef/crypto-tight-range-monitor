# Neon (or any Postgres) connection string
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Password you type on the /login page
APP_PASSWORD=change-me
# Long random string (32+ chars) used to sign the login cookie
SESSION_SECRET=change-me-to-a-long-random-string
# Long random string; cron-job.org sends it as "Authorization: Bearer <value>"
CRON_SECRET=change-me-too
# Optional: Telegram alerts (range alerts + simulated entries/exits)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
